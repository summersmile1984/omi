# Fork image inputs. Supply a public brand manifest under this repository;
# production requires explicit operator-owned endpoint bindings.
BACKEND_RUNTIME_IMAGE=omi-backend-runtime:self-host
SELF_HOST_STAGE=production
SELF_HOST_BRAND_MANIFEST=brand/omi-upstream/manifest.yaml
# Copy to deploy/self-host/.env.production, replace every REPLACE_* value, and
# keep the resulting file outside version control. Passwords embedded in DSNs
# need their separately URL-encoded form in POSTGRES_PASSWORD_URLENCODED.
# Backup encryption is an operations-only host setting, not a Compose secret;
# keep the 32-byte mode-0600 key outside this env file and export its path only
# when invoking operations.sh backup, verify-backup, rollback-plan, or restore.
# SELF_HOST_BACKUP_KEY_FILE=/secure/omi-self-host-backup.key
# The generated self-host profile enables pinned local speech; provision and
# mount SPEECH_MODEL_STORE before startup. Push remains disabled.
# Ambient vendor keys cannot select a different provider or enable push.

SELF_HOST_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
AUTH_SERVER_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

PUBLIC_BACKEND_URL=https://api.example.com
PUBLIC_AUTH_URL=https://auth.example.com
PUBLIC_MCP_URL=https://mcp.example.com
PUBLIC_OBJECTS_URL=https://objects.example.com
# Comma-separated external authorities the backend may contact. Compose
# service names and host.docker.internal are internal authorities covered by
# the runtime guard; every other external host must be declared here. This is
# an application guard only, not a substitute for the operator's network
# firewall/default-deny policy and its cutover evidence.
SELF_HOST_EGRESS_ALLOWLIST=llm.example.com,realtime.example.com,objects.example.com
# Optional operator-owned HTTPS manual desktop installer/repair page. If it
# is omitted, the backend returns typed desktop-update unavailability rather
# than an Omi URL. An active Firestore desktop_update_policy may also carry
# its own operator-owned download_url.
DESKTOP_UPDATE_DOWNLOAD_URL=
# Operator-owned HTTPS origin for minted conversation/task share links. This
# must not be an Omi-operated host; the backend fails closed if it is absent.
OMI_SHARE_BASE_URL=https://share.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com
BETTER_AUTH_IP_HEADERS=x-forwarded-for

BACKEND_IMAGE=omi-backend:self-host-production
BACKEND_PLATFORM=linux/amd64
AUTH_SERVER_IMAGE=omi-auth-server:self-host-production
LLM_IMAGE=omi-llm:self-host-production

POSTGRES_USER=omi
POSTGRES_DB=omi
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
POSTGRES_PASSWORD_URLENCODED=REPLACE_WITH_URLENCODED_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
MINIO_ACCESS_KEY=REPLACE_WITH_RANDOM_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_MINIO_SECRET_KEY
MINIO_REGION=us-east-1
QDRANT_API_KEY=REPLACE_WITH_RANDOM_QDRANT_API_KEY
QDRANT_COLLECTION_PREFIX=omi
TYPESENSE_API_KEY=REPLACE_WITH_RANDOM_TYPESENSE_API_KEY
SEARXNG_SECRET=REPLACE_WITH_RANDOM_SEARXNG_SECRET
# The production default is fully local. `openai_compatible` remains available
# only for an explicit non-vendor operator endpoint.
APP_ICON_GENERATION_TRANSPORT=local_template
IMAGE_GENERATION_OPENAI_COMPATIBLE_BASE_URL=
IMAGE_GENERATION_OPENAI_COMPATIBLE_API_KEY=
IMAGE_GENERATION_OPENAI_COMPATIBLE_MODEL=

# Operator-owned release manifest and every asset must use this exact public
# object origin. Empty bearer is permitted for a publicly readable manifest.
FIRMWARE_RELEASE_MANIFEST_URL=https://objects.example.com/omi-firmware/releases.json
FIRMWARE_RELEASE_ASSET_ORIGIN=https://objects.example.com
FIRMWARE_RELEASE_MANIFEST_BEARER_TOKEN=

BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_INTERNAL_ADMIN_SECRET=REPLACE_WITH_RANDOM_AUTH_ADMIN_SECRET
AUTH_JWKS_ROTATION_SECONDS=2592000
AUTH_JWKS_GRACE_SECONDS=172800
ENCRYPTION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MEMORY_V3_CURSOR_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
QUEUE_REDIS_SYNC_WORKER_SECRET=REPLACE_WITH_RANDOM_SYNC_WORKER_SECRET
QUEUE_REDIS_AUDIO_MERGE_WORKER_SECRET=REPLACE_WITH_RANDOM_AUDIO_WORKER_SECRET
QUEUE_REDIS_ACCOUNT_DELETION_WORKER_SECRET=REPLACE_WITH_RANDOM_DELETION_WORKER_SECRET
QUEUE_REDIS_FINALIZATION_WORKER_SECRET=REPLACE_WITH_RANDOM_FINALIZATION_WORKER_SECRET

# Provision the profile-selected Qwen3 model once, before starting Compose:
# python3 deploy/self-host/prepare-model.py --kind llm --output /srv/memweft/llm
# The API uses the internal Ollama authority, verifies identity and refuses
# truncation. No cloud key or fallback endpoint is used by text features.
LLM_MODEL_STORE=/srv/memweft/llm
# OpenAI-compatible realtime WebSocket operated by this deployment or another
# explicitly trusted service. The credential is injected only by the backend.
REALTIME_MODEL=REPLACE_WITH_REALTIME_MODEL_ID
REALTIME_RELAY_URL=wss://realtime.example.com/v1/realtime
REALTIME_RELAY_API_KEY=REPLACE_WITH_REALTIME_ENDPOINT_KEY
REALTIME_RELAY_PROVIDER_ID=generic
REALTIME_RELAY_WIRE_PROTOCOL=openai_realtime_v1
REALTIME_RELAY_ALLOWED_HOSTS=realtime.example.com
REALTIME_RELAY_MAX_MESSAGE_BYTES=1048576
REALTIME_RELAY_MAX_SESSION_SECONDS=1800
VECTOR_PROJECTION_MODE=single
VECTOR_PROJECTION_ACTIVE_VERSION=v1
VECTOR_PROJECTION_TARGET_VERSION=
VECTOR_PROJECTION_SCHEMA_VERSION=1
VECTOR_PROJECTION_DELETE_VERSIONS=v1
VECTOR_PROJECTION_REQUIRED_NAMESPACES=ns1,ns2,workstream-association-v1,ns_x,ns3,ns4,ns_tchunks

# This intermediate profile enables local embedding and disables speech/push.
# Full audio/cutover acceptance remains unavailable until an enabled provider
# and the full runtime evidence contract are implemented (SH3/SH4 plan).

# Read-only Ollama store containing exactly the model pinned in
# deploy/profiles/self_hosted.yaml (manifest plus all referenced blobs).
# Model identity and dimensions have no independent environment defaults.
EMBEDDING_MODEL_STORE=/srv/omi/models/embedding

# Provision with prepare-speech.py; both ASR/TTS and all resources are SHA-256 admitted.
SPEECH_MODEL_STORE=/srv/omi/models/speech
