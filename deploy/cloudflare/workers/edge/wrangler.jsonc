{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omi-cf-edge-staging",
  "main": "index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [
    { "binding": "AUTH", "service": "omi-cf-auth-staging" },
    { "binding": "API_CORE", "service": "omi-cf-api-core-staging" },
    { "binding": "API_AI", "service": "omi-cf-api-ai-staging" },
    { "binding": "REALTIME", "service": "omi-cf-realtime-staging" },
    { "binding": "JOBS", "service": "omi-cf-jobs-staging" },
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "omi-cf-app-staging",
      "database_id": "995078e7-d4f2-4efd-ad81-22f85ccaf1c8",
      "migrations_dir": "../../migrations/app",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITS",
        "class_name": "SharedRateLimitDurableObject",
        "script_name": "omi-cf-rate-limit-staging",
      },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimitDurableObject"] },
    { "tag": "v2", "deleted_classes": ["RateLimitDurableObject"] },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://omi-web-app-staging.summersmile1984.workers.dev",
    "MCP_RESOURCE_URL": "https://omi-cf-edge-staging.summersmile1984.workers.dev/v1/mcp/sse",
    "MCP_AUTHORIZATION_SERVER_URL": "https://omi-web-app-staging.summersmile1984.workers.dev/api/auth",
    "RATE_LIMIT_BOOST": "1.0",
    "RATE_LIMIT_SHADOW_MODE": "false",
    "AUTH_OAUTH_STAGING_FAIL_CLOSED": "true",
    "AUTH_EXACT_NATIVE_STAGING_ENABLED": "true",
    "AUTH_EXACT_OAUTH_STAGING_ENABLED": "true",
    "PHONE_TWILIO_STAGING_FAIL_CLOSED": "true",
    "GEMINI_PROXY_STAGING_FAIL_CLOSED": "true",
    "GEMINI_PROXY_CLOUDFLARE_ENABLED": "false",
    "CHAT_COMPAT_STAGING_FAIL_CLOSED": "true",
    "CHAT_COMPATIBILITY_CLOUDFLARE_ENABLED": "true",
    "AI_COMPAT_STAGING_FAIL_CLOSED": "true",
    "CHAT_ATTACHMENT_ENVELOPE_STAGING_ENABLED": "false",
    "PERSONA_APPS_STAGING_FAIL_CLOSED": "true",
    "APP_OWNER_MIGRATION_EXACT_STAGING_ENABLED": "false",
    "TWITTER_OWNERSHIP_EXACT_STAGING_ENABLED": "false",
    "MCP_APP_EXACT_LEGACY_STAGING_ENABLED": "true",
    "LEGACY_CHAT_FILES_STAGING_ENABLED": "true",
    "TASK_INTELLIGENCE_STAGING_FAIL_CLOSED": "true",
  },
}
