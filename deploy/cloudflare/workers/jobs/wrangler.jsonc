{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omi-cf-jobs-staging",
  "main": "index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "omi-cf-app-staging",
      "migrations_dir": "../../migrations/app",
    },
  ],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "omi-cf-staging" }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "omi-cf-jobs-staging" }],
    "consumers": [
      {
        "queue": "omi-cf-jobs-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 10,
        "dead_letter_queue": "omi-cf-jobs-dlq-staging",
      },
    ],
  },
}
