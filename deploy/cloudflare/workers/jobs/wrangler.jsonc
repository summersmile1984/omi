{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omi-cf-jobs-staging",
  "main": "index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "opus-decoder": "./opus-decoder-core.ts",
    "@wasm-audio-decoders/common": "./wasm-audio-common.ts",
  },
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 300000 },
  "services": [{ "binding": "AUTH", "service": "omi-cf-auth-staging" }],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "omi-cf-app-staging",
      "migrations_dir": "../../migrations/app",
    },
  ],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "omi-cf-staging" }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "omi-cf-jobs-staging" },
      { "binding": "SYNC_FRESH", "queue": "omi-cf-sync-fresh-staging" },
      { "binding": "SYNC_BACKFILL", "queue": "omi-cf-sync-backfill-staging" },
    ],
    "consumers": [
      {
        "queue": "omi-cf-jobs-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 10,
        "dead_letter_queue": "omi-cf-jobs-dlq-staging",
      },
      {
        "queue": "omi-cf-sync-fresh-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 10,
        "dead_letter_queue": "omi-cf-jobs-dlq-staging",
      },
      {
        "queue": "omi-cf-sync-backfill-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 30,
        "max_concurrency": 4,
        "dead_letter_queue": "omi-cf-jobs-dlq-staging",
      },
    ],
  },
}
