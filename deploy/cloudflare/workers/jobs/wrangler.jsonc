{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omi-cf-jobs-staging",
  "main": "index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "opus-decoder": "./opus-decoder-core.ts",
    "@wasm-audio-decoders/common": "./wasm-audio-common.ts",
  },
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "PUBLIC_API_BASE_URL": "https://omi-cf-edge-staging.summersmile1984.workers.dev",
    "WORKERS_AI_VECTOR_MODEL": "@cf/baai/bge-m3",
    "WORKERS_AI_X_MEMORY_MODEL": "@cf/meta/llama-3.2-3b-instruct",
  },
  // Secrets provisioned with `wrangler secret put`: ADMIN_KEY, APPS_ADMIN_KEY,
  // FIREBASE_SERVICE_ACCOUNT_JSON, INTERNAL_ASSERTION_SECRET, Stripe secrets,
  // X_OAUTH_CLIENT_ID, X_OAUTH_CLIENT_SECRET, X_OAUTH_REDIRECT_URI,
  // X_TOKEN_ENCRYPTION_SECRET, TASK_INTEGRATION_TOKEN_ENCRYPTION_SECRET,
  // GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET (optional shared Better Auth client),
  // GOOGLE_CALENDAR_CLIENT_ID, GOOGLE_CALENDAR_CLIENT_SECRET,
  // GOOGLE_CALENDAR_TOKEN_ENCRYPTION_SECRET,
  // TODOIST_CLIENT_ID/TODOIST_CLIENT_SECRET, ASANA_CLIENT_ID/ASANA_CLIENT_SECRET,
  // GOOGLE_TASKS_CLIENT_ID/GOOGLE_TASKS_CLIENT_SECRET,
  // CLICKUP_CLIENT_ID/CLICKUP_CLIENT_SECRET, and optional RAPID_API_HOST/RAPID_API_KEY.
  "services": [{ "binding": "AUTH", "service": "omi-cf-auth-staging" }],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "omi-cf-app-staging",
      "migrations_dir": "../../migrations/app",
    },
  ],
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "omi-cf-staging" },
    {
      "binding": "CONVERSATION_RECORDINGS",
      "bucket_name": "omi-cf-conversation-recordings-staging",
    },
    {
      "binding": "SPEECH_PROFILES",
      "bucket_name": "omi-cf-speech-profiles-staging",
    },
  ],
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "MEMORY_VECTORS", "index_name": "omi-cf-memories-v2" },
    {
      "binding": "ACTION_ITEM_VECTORS",
      "index_name": "omi-cf-action-items-v2",
    },
    {
      "binding": "CONVERSATION_VECTORS",
      "index_name": "omi-cf-conversations-v2",
    },
    {
      "binding": "TRANSCRIPT_CHUNK_VECTORS",
      "index_name": "omi-cf-transcript-chunks-v2",
    },
    { "binding": "X_POST_VECTORS", "index_name": "omi-cf-x-posts-v2" },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "omi-cf-jobs-staging" },
      { "binding": "SYNC_FRESH", "queue": "omi-cf-sync-fresh-staging" },
      { "binding": "SYNC_BACKFILL", "queue": "omi-cf-sync-backfill-staging" },
    ],
    "consumers": [
      {
        "queue": "omi-cf-jobs-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 10,
        "dead_letter_queue": "omi-cf-jobs-dlq-staging",
      },
      {
        "queue": "omi-cf-sync-fresh-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 10,
        "dead_letter_queue": "omi-cf-jobs-dlq-staging",
      },
      {
        "queue": "omi-cf-sync-backfill-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 30,
        "max_concurrency": 4,
        "dead_letter_queue": "omi-cf-jobs-dlq-staging",
      },
    ],
  },
}
