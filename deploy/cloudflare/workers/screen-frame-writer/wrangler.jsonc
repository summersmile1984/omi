{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omi-cf-screen-frame-writer-staging",
  "main": "index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "omi-cf-app-staging",
      "migrations_dir": "../../migrations/app"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCREEN_FRAMES",
      "bucket_name": "omi-cf-screen-frames-staging"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
