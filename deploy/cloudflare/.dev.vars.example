# Copy to .dev.vars locally. Never commit real values.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
INTERNAL_ASSERTION_SECRET=replace-with-a-different-random-secret
# Optional Better Auth social providers. A provider is hidden unless both
# client ID and secret are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
# Debug-only Flutter bridge; leave empty for normal local auth.
AUTH_DEV_ISSUER_SECRET=
ASR_WS_URL=
ASR_API_KEY=
ASR_API_BASE_URL=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
AI_API_BASE_URL=
AI_API_KEY=
TTS_API_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
ARTIFICIALANALYSIS_API_KEY=
ARTIFICIALANALYSIS_API_URL=https://artificialanalysis.ai/api/v2/data/llms/models
GITHUB_TOKEN=
FIREBASE_API_KEY=
GOOGLE_CALENDAR_API_KEY=
DESKTOP_LEGACY_ANTHROPIC_KEY=
# Staging-only announcement publishing key; never use a release/client secret here.
ANNOUNCEMENTS_ADMIN_KEY=
