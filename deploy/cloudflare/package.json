{
  "name": "omi-cloudflare-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node scripts/validate-manifests.mjs",
    "pretest": "npm run validate:manifest",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill:d1": "node scripts/backfill-d1.mjs",
    "benchmark:staging": "node scripts/benchmark-staging.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "deploy:staging": "npm run validate:manifest && node scripts/deploy.mjs staging"
  },
  "dependencies": {
    "better-auth": "1.6.26",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260827.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0",
    "yaml": "2.9.0"
  }
}
