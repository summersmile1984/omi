{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "omi-cf-api-core-staging",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "omi-cf-app-staging",
      "migrations_dir": "../../migrations/app"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "omi-cf-staging"
    }
  ],
  "vars": {}
}
