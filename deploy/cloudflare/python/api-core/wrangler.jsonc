{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "omi-cf-api-core-staging",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "omi-cf-app-staging",
      "migrations_dir": "../../migrations/app",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "omi-cf-staging",
    },
  ],
  "vars": {
    "ACCOUNT_CUTOVER_PROFILE": "isolated-staging",
    "FREE_CHAT_QUESTIONS_PER_MONTH": "30",
    "NEO_CHAT_QUESTIONS_PER_MONTH": "200",
    "PLUS_CHAT_QUESTIONS_PER_MONTH": "200",
    "UNLIMITED_V2_CHAT_QUESTIONS_PER_MONTH": "1000",
    "OPERATOR_CHAT_QUESTIONS_PER_MONTH": "500",
    "ARCHITECT_CHAT_COST_USD_PER_MONTH": "400.0",
    "OVERAGE_MARKUP_MULTIPLIER": "1.15",
    "TRIAL_PAYWALL_ENABLED": "false",
    "TRIAL_LENGTH_SECONDS": "259200",
    "WORKERS_AI_INTEGRATION_MODEL": "@cf/meta/llama-3.2-3b-instruct",
  },
}
