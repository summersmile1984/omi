# Copy to .env and replace every example origin with infrastructure controlled
# by the operator. `build:selfhost:win` fails before compilation if any required
# authority is missing, uses HTTP, or resolves to an Omi/Firebase/model-vendor host.
VITE_OMI_DEPLOYMENT_PROFILE=self_hosted
VITE_OMI_IDENTITY_PROVIDER=better_auth
VITE_OMI_API_BASE=https://api.example.invalid
VITE_OMI_DESKTOP_API_BASE=https://desktop.example.invalid
VITE_OMI_AUTH_BASE=https://auth.example.invalid
VITE_OMI_MCP_BASE=https://mcp.example.invalid

# Optional operator-owned capabilities. Empty means disabled; there is no Omi
# share, analytics, or update fallback in the self_hosted profile.
VITE_OMI_SHARE_BASE_URL=
VITE_OMI_ANALYTICS_BASE=
VITE_POSTHOG_KEY=
VITE_OMI_UPDATE_FEED_URL=

# Optional public OAuth clients registered by this operator's MCP deployment.
# A missing provider id omits that provider's public connector card; the app
# never borrows Omi's registered OAuth clients in the self_hosted profile.
VITE_OMI_MCP_CHATGPT_OAUTH_CLIENT_ID=
VITE_OMI_MCP_CLAUDE_OAUTH_CLIENT_ID=

# Firebase and direct model-vendor credentials are intentionally absent. Google
# OAuth/API and the Omi-owned Gmail session connector are disabled by the
# self_hosted deployment policy even if credentials are supplied accidentally.
VITE_OMI_API_KEY=
VITE_ENABLE_GOOGLE_INTEGRATION=0
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
