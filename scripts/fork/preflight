#!/usr/bin/env bash
# Fork preflight: the upstream contract gate, then the fork-owned one.
#
# `make preflight` runs only the upstream manifest (its runner hardcodes that
# path). This wrapper runs both, so a fork PR is checked by the same two lanes
# CI uses. --fork-only selects just the dedicated Fork Checks workflow lane;
# the default continues to require the upstream and fork checks together.
# Usage: scripts/fork/preflight [--base REF] [--fork-only]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

BASE="origin/main"
FORK_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base) BASE="$2"; shift 2 ;;
    --fork-only) FORK_ONLY=1; shift ;;
    *) echo "usage: scripts/fork/preflight [--base REF] [--fork-only]" >&2; exit 2 ;;
  esac
done

source scripts/dev-harness/_resolve_python.sh
PYTHON_BIN="$(dev_harness_python)"
# .github/scripts/git_bash.py uses PEP 604 unions, so the runner needs >= 3.10.
if ! "$PYTHON_BIN" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
  for candidate in python3.13 python3.12 python3.11; do
    if command -v "$candidate" >/dev/null 2>&1; then PYTHON_BIN="$candidate"; break; fi
  done
fi
if ! "$PYTHON_BIN" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
  echo "FAIL: need Python >= 3.10 for the check runner; found $("$PYTHON_BIN" --version 2>&1)" >&2
  echo "      Install a newer python3 (brew install python@3.12) and re-run." >&2
  exit 2
fi

# Checks spawn their own `python3` (e.g. check-manifest-contract runs
# .github/scripts/test_run_checks.py, which imports git_bash.py and its PEP 604
# unions). Selecting the interpreter for this script is not enough: it has to be
# the `python3` those child processes resolve. macOS ships 3.9 as `python3`.
if [ "$(command -v python3)" != "$(command -v "$PYTHON_BIN")" ]; then
  SHIM_DIR="$(mktemp -d)"
  trap 'rm -rf "$SHIM_DIR"' EXIT
  # A symlink outside .venv loses pyvenv.cfg discovery and its locked packages.
  # Exec the selected path so child checks retain the interpreter's environment.
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$(command -v "$PYTHON_BIN")" > "$SHIM_DIR/python3"
  chmod +x "$SHIM_DIR/python3"
  PATH="$SHIM_DIR:$PATH"
  export PATH
  echo "note: using $("$PYTHON_BIN" --version 2>&1) as python3 for this run"
fi

if [ "$FORK_ONLY" = 0 ]; then
  echo "==> upstream contract gate (.github/checks-manifest.yaml)"
  "$PYTHON_BIN" .github/scripts/pr_preflight.py --lane local --base "$BASE"
fi

echo
echo "==> fork gate (.github/checks-manifest.fork.yaml)"
"$PYTHON_BIN" .github/scripts/run_checks.py \
  --manifest .github/checks-manifest.fork.yaml --lane local --base "$BASE"
