#!/usr/bin/env bash
# Fork preflight: the upstream contract gate, then the fork-owned one.
#
# `make preflight` runs only the upstream manifest (its runner hardcodes that
# path). This wrapper runs both, so a fork PR is checked by the same two lanes
# CI uses. --fork-only selects just the dedicated Fork Checks workflow lane;
# the default continues to require the upstream and fork checks together.
# Usage: scripts/fork/preflight [--base REF] [--fork-only]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

BASE="origin/main"
FORK_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base) BASE="$2"; shift 2 ;;
    --fork-only) FORK_ONLY=1; shift ;;
    *) echo "usage: scripts/fork/preflight [--base REF] [--fork-only]" >&2; exit 2 ;;
  esac
done

source scripts/dev-harness/_resolve_python.sh
PYTHON_BIN="$(dev_harness_python)"
# .github/scripts/git_bash.py uses PEP 604 unions, so the runner needs >= 3.10.
if ! "$PYTHON_BIN" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
  for candidate in python3.13 python3.12 python3.11; do
    if command -v "$candidate" >/dev/null 2>&1; then PYTHON_BIN="$candidate"; break; fi
  done
fi
if ! "$PYTHON_BIN" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
  echo "FAIL: need Python >= 3.10 for the check runner; found $("$PYTHON_BIN" --version 2>&1)" >&2
  echo "      Install a newer python3 (brew install python@3.12) and re-run." >&2
  exit 2
fi

# Checks spawn their own `python3` (e.g. check-manifest-contract runs
# .github/scripts/test_run_checks.py, which imports git_bash.py and its PEP 604
# unions). Selecting the interpreter for this script is not enough: it has to be
# the `python3` those child processes resolve. macOS ships 3.9 as `python3`.
if [ "$(command -v python3)" != "$(command -v "$PYTHON_BIN")" ]; then
  SHIM_DIR="$(mktemp -d)"
  trap 'rm -rf "$SHIM_DIR"' EXIT
  # A symlink outside .venv loses pyvenv.cfg discovery and its locked packages.
  # Exec the selected path so child checks retain the interpreter's environment.
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$(command -v "$PYTHON_BIN")" > "$SHIM_DIR/python3"
  chmod +x "$SHIM_DIR/python3"
  PATH="$SHIM_DIR:$PATH"
  export PATH
  echo "note: using $("$PYTHON_BIN" --version 2>&1) as python3 for this run"
fi

if [ "$FORK_ONLY" = 0 ]; then
  echo "==> upstream contract gate (.github/checks-manifest.yaml)"
  "$PYTHON_BIN" .github/scripts/pr_preflight.py --lane local --base "$BASE" --metadata-only
  "$PYTHON_BIN" scripts/fork/upstream_checks.py --lane local --base "$BASE" --skip-pr-body-checks
fi

# White-label gates (fork constitution: dev/unified-main/WHITELABEL-MODEL.md).
# These run before the fork manifest gate so a brand-template regression is
# caught at the same level as upstream contract drift, not buried under 12
# other checks. The brand/profile paths are anchored at $ROOT (resolved above
# from BASH_SOURCE) so a CI lane that copies this script into an isolated
# tree -- the fork-ci-diff-base fixture does exactly this to verify the
# python3 shim -- still finds them via the source-tree root.
echo
echo "==> whitelabel gate (apply + profile + tooling)"
WHITELABEL_PATHS_OK=1
if [ -x "$ROOT/scripts/brand/apply.py" ]; then
  "$PYTHON_BIN" "$ROOT/scripts/brand/apply.py" --brand omi-upstream --check-clean || WHITELABEL_PATHS_OK=0
  "$PYTHON_BIN" "$ROOT/scripts/profiles/check_tables.py" || WHITELABEL_PATHS_OK=0
  "$PYTHON_BIN" -m unittest discover -s "$ROOT/scripts/brand" -p 'test_*.py' 2>&1 | tail -5 || WHITELABEL_PATHS_OK=0
  # Eddy-restore round-trip: prove the eddy switch leaves the two declared
  # generated files byte-identical to omi-upstream after restoration. Any
  # other path the apply phase touched is reported by name and fails the
  # gate. Paths the user already had dirty before preflight started are
  # tolerated; only paths newly added to the dirty set are rejected.
  PRE_DIRTY=$(cd "$ROOT" && git diff --name-only)
  "$PYTHON_BIN" "$ROOT/scripts/brand/apply.py" --brand eddy >/dev/null || WHITELABEL_PATHS_OK=0
  "$PYTHON_BIN" "$ROOT/scripts/brand/apply.py" --brand omi-upstream >/dev/null || WHITELABEL_PATHS_OK=0
  POST_DIRTY=$(cd "$ROOT" && git diff --name-only)
  ALLOWED=('app/lib/flavors.brand.dart' 'backend/fork/firmware_brand.generated.json')
  NEW_DIRTY=()
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    case " ${ALLOWED[*]} " in
      *" $path "*) continue ;;
    esac
    case " $(echo "$PRE_DIRTY" | tr '\n' ' ') " in
      *" $path "*) continue ;;
    esac
    NEW_DIRTY+=("$path")
  done <<< "$POST_DIRTY"
  if [ "${#NEW_DIRTY[@]}" -gt 0 ]; then
    echo "FAIL: eddy -> omi-upstream round-trip wrote paths outside the two declared generated files:" >&2
    printf '  %s\n' "${NEW_DIRTY[@]}" >&2
    WHITELABEL_PATHS_OK=0
  fi
else
  echo "skip: brand tooling not present in this tree (fork-ci-diff-base fixture)"
fi
[ "$WHITELABEL_PATHS_OK" = "1" ] || exit 1

echo
echo "==> fork gate (.github/checks-manifest.fork.yaml)"
"$PYTHON_BIN" .github/scripts/run_checks.py \
  --manifest .github/checks-manifest.fork.yaml --lane local --base "$BASE"
