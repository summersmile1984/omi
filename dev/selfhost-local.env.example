# Local Server OS (self-hosted) runtime environment for a checkout run.
#
# Copy to dev/selfhost-local.env (gitignored) and adjust. This is the env the
# image normally bakes in; dev/selfhost-local.sh renders the core-only
# self_hosted.local profile and starts `uvicorn fork.main:app` with these values.
#
# Services it expects (`dev/local.sh up` starts all of them):
#   postgres 5442 · redis 6379 (auth) · minio 9100
#   qdrant 6333 (api key) · typesense 8108 (api key)
# Ollama is only needed for the full profile (speech/LLM); the core-only shape
# this script renders needs neither.

OMI_DEPLOYMENT_PROFILE=self_hosted.local
OMI_DEPLOYMENT_TARGET=self_hosted
OMI_ENV_STAGE=local

FIRESTORE_PG_DSN=postgresql+psycopg://omi:omi-dev-password@127.0.0.1:5442/omi

REDIS_DB_HOST=127.0.0.1
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=omi-local-redis-password

MINIO_ENDPOINT=http://127.0.0.1:9100
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
STORAGE_BACKEND=minio
BUCKET_SPEECH_PROFILES=omi-speech-profiles
BUCKET_POSTPROCESSING=omi-postprocessing
BUCKET_MEMORIES_RECORDINGS=omi-memories-recordings
BUCKET_PRIVATE_CLOUD_SYNC=omi-private-cloud-sync
BUCKET_TEMPORAL_SYNC_LOCAL=omi-temporal-sync-local
BUCKET_PLUGINS_LOGOS=omi-plugins-logos
BUCKET_APP_THUMBNAILS=omi-app-thumbnails
BUCKET_CHAT_FILES=omi-chat-files
BUCKET_DESKTOP_UPDATES=omi-desktop-updates

# The core-only profile keeps the embedding capability, so an embedding origin is
# required even though speech/LLM are dropped. Local ollama already carries the
# pinned bge-m3 artifact (id 790764642607).
EMBEDDING_ENDPOINT=http://127.0.0.1:11434

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=omi-local-qdrant-key
QDRANT_COLLECTION_PREFIX=omi_local

TYPESENSE_HOST=127.0.0.1
TYPESENSE_HOST_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=omi-local-typesense-key
MEMORY_TYPESENSE_COLLECTION=memories

ENCRYPTION_SECRET=YdtqMcLQx1E9r65YS2lRB9eycbcr76RWmizKq8UecTA=
AUTH_PROVIDER=better_auth
AUTH_JWKS_URL=http://127.0.0.1:3000/api/auth/jwks
AUTH_DEV_ISSUER_SECRET=omi-local-dev-issuer-change-me

# JWT authority plus the backend's session check against the auth-server.
# AUTH_INTERNAL_ADMIN_SECRET must equal the value dev/local.sh gives the
# auth-server; AUTH_INTERNAL_ALLOW_HTTP is required for a loopback http origin.
AUTH_JWT_ISSUER=http://127.0.0.1:3000
AUTH_JWT_AUDIENCE=http://127.0.0.1:3000
AUTH_SERVER_INTERNAL_URL=http://127.0.0.1:3000
AUTH_INTERNAL_ALLOW_HTTP=true
AUTH_INTERNAL_ADMIN_SECRET=omi-local-internal-admin-secret

PUBLIC_BACKEND_URL=http://127.0.0.1:8100/
PUBLIC_AUTH_URL=http://127.0.0.1:3000
PUBLIC_MCP_URL=http://127.0.0.1:8100
PUBLIC_OBJECTS_URL=http://127.0.0.1:9100
OMI_SHARE_BASE_URL=http://127.0.0.1:3001

QUEUE_BACKEND=redis
# Each queue secret must be at least 32 characters (backend/fork/queue_config.py).
QUEUE_REDIS_SYNC_WORKER_SECRET=omi-local-queue-worker-change-me
QUEUE_REDIS_AUDIO_MERGE_WORKER_SECRET=omi-local-queue-worker-change-me
QUEUE_REDIS_ACCOUNT_DELETION_WORKER_SECRET=omi-local-queue-worker-change-me
QUEUE_REDIS_FINALIZATION_WORKER_SECRET=omi-local-queue-worker-change-me
SYNC_TASKS_HANDLER_URL=http://127.0.0.1:8100/v2/sync-jobs/run
AUDIO_MERGE_HANDLER_URL=http://127.0.0.1:8100/v2/audio-merge-jobs/run
ACCOUNT_DELETION_HANDLER_URL=http://127.0.0.1:8100/v1/users/account-deletion-wipes/run
LISTEN_FINALIZATION_TASKS_HANDLER_URL=http://127.0.0.1:8100/v1/conversation-finalization-jobs/run
