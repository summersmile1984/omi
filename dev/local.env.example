# Omi local dev — defaults for the cloud-neutral stack (stage 1: compile + run).
#
# You normally do not edit this file. To change something on your machine:
#
#   cp dev/local.env.example dev/local.env    # gitignored
#   # edit dev/local.env, then:
#   dev/local.sh up
#
# Layering (strongest first):
#   ambient environment  >  dev/local.env  >  dev/local.env.example
#
# All ports are HOST ports. Container-internal ports never change.

# --- data plane -------------------------------------------------------------
# Postgres (firestore-pg shim — same shape as the production deployment)
OMI_LOCAL_POSTGRES_PORT=5434
# Redis (queue + cache)
OMI_LOCAL_REDIS_PORT=6379
# MinIO (object storage replacing GCS) — S3 API and web console
OMI_LOCAL_MINIO_API_PORT=9000
OMI_LOCAL_MINIO_CONSOLE_PORT=9001
OMI_LOCAL_QDRANT_PORT=6333
OMI_LOCAL_QDRANT_GRPC_PORT=6334
OMI_LOCAL_TYPESENSE_PORT=8108
OMI_LOCAL_QDRANT_API_KEY=omi-local-qdrant-key
# Switching embedding authority requires a reviewed new prefix/backfill, never
# relabeling existing vectors. The legacy local-model prefix stays unchanged.
OMI_LOCAL_QDRANT_COLLECTION_PREFIX=omi_local
OMI_LOCAL_TYPESENSE_API_KEY=omi-local-typesense-key

# --- emulators --------------------------------------------------------------
# Firebase emulator suite (Firestore / Auth / Storage)
OMI_LOCAL_FIRESTORE_PORT=8080
OMI_LOCAL_FIREBASE_AUTH_PORT=9099
OMI_LOCAL_FIREBASE_STORAGE_PORT=9199

# --- application ------------------------------------------------------------
# Better Auth auth-server (JWT issuance + JWKS consumed by the backend shim)
OMI_LOCAL_AUTH_PORT=3000
# Backend (FastAPI/uvicorn)
OMI_LOCAL_BACKEND_PORT=8100
OMI_LOCAL_SHARE_PORT=3001
# Inference selection never changes PostgreSQL / Redis / MinIO / Qdrant storage.
# core-only disables speech/chat, but vector operations use this local embedding
# service (the canonical self_hosted model contract requires bge-m3).
OMI_LOCAL_AI_PROFILE=core-only
OMI_LOCAL_EMBEDDING_ENDPOINT=http://127.0.0.1:11434
OMI_LOCAL_BRAND_MANIFEST="$_REPO_ROOT/brand/omi-upstream/manifest.yaml"
# Explicit operator-AI credentials, read only for the selected provider:
# OMI_LOCAL_MIMO_API_KEY=
# OMI_LOCAL_OPENROUTER_API_KEY=
# OMI_LOCAL_SILICONFLOW_API_KEY=
# OMI_LOCAL_CLOUDFLARE_API_TOKEN=
# cloudflare-gateway also requires your private brand manifest's gateway identity.

# --- secrets (dev-only values; never reuse outside local dev) ---------------
# Deterministic by default so restarting the stack keeps existing data and
# signing keys readable. Replace with random values for a throwaway database.
OMI_LOCAL_BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-32bytes-min
OMI_LOCAL_AUTH_DEV_ISSUER_SECRET=omi-local-dev-issuer-change-me
OMI_LOCAL_QUEUE_WORKER_SECRET=omi-local-queue-worker-change-me
# The self-hosted runtime requires a Redis password (backend/fork/bootstrap.py),
# so the local Redis server authenticates with this value.
OMI_LOCAL_REDIS_PASSWORD=omi-local-redis-password
# Shared with the auth-server so the backend can verify live sessions
# (POST /internal/verify); the auth-server reads AUTH_INTERNAL_ADMIN_SECRET.
OMI_LOCAL_INTERNAL_ADMIN_SECRET=omi-local-internal-admin-secret
OMI_LOCAL_ENCRYPTION_SECRET=YdtqMcLQx1E9r65YS2lRB9eycbcr76RWmizKq8UecTA=
