# Omi local dev — defaults for the cloud-neutral stack (stage 1: compile + run).
#
# You normally do not edit this file. To change something on your machine:
#
#   cp dev/local.env.example dev/local.env    # gitignored
#   # edit dev/local.env, then:
#   dev/local.sh up
#
# Layering (strongest first):
#   ambient environment  >  dev/local.env  >  dev/local.env.example
#
# All ports are HOST ports. Container-internal ports never change.

# --- data plane -------------------------------------------------------------
# Postgres (firestore-pg shim — same shape as the production deployment)
OMI_LOCAL_POSTGRES_PORT=5434
# Redis (queue + cache)
OMI_LOCAL_REDIS_PORT=6379
# MinIO (object storage replacing GCS) — S3 API and web console
OMI_LOCAL_MINIO_API_PORT=9000
OMI_LOCAL_MINIO_CONSOLE_PORT=9001

# --- emulators --------------------------------------------------------------
# Firebase emulator suite (Firestore / Auth / Storage)
OMI_LOCAL_FIRESTORE_PORT=8080
OMI_LOCAL_FIREBASE_AUTH_PORT=9099
OMI_LOCAL_FIREBASE_STORAGE_PORT=9199

# --- application ------------------------------------------------------------
# Better Auth auth-server (JWT issuance + JWKS consumed by the backend shim)
OMI_LOCAL_AUTH_PORT=3000
# Backend (FastAPI/uvicorn)
OMI_LOCAL_BACKEND_PORT=8100

# --- secrets (dev-only values; never reuse outside local dev) ---------------
# Deterministic by default so restarting the stack keeps existing data and
# signing keys readable. Replace with random values for a throwaway database.
OMI_LOCAL_BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-32bytes-min
OMI_LOCAL_AUTH_DEV_ISSUER_SECRET=omi-local-dev-issuer-change-me
OMI_LOCAL_QUEUE_WORKER_SECRET=omi-local-queue-worker-change-me
OMI_LOCAL_ENCRYPTION_SECRET=YdtqMcLQx1E9r65YS2lRB9eycbcr76RWmizKq8UecTA=
