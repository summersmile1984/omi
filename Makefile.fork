# Fork-owned make targets. Kept out of the upstream Makefile so that file stays
# byte-identical on every sync. Use: make -f Makefile.fork <target>
BASE ?= origin/main
BRAND ?= omi-upstream

.PHONY: help setup-fork preflight-fork upstream-touch sync-probe dev-shadow-diff run-canonical-promotion \
	local-up local-status local-verify local-restart local-logs local-down local-reset local-selftest \
	local-tc-up local-tc-status local-tc-down local-tc-reset local-tc-check local-tc-logs

help:
	@echo "make -f Makefile.fork setup-fork       # fork-local git config (no upstream tags)"
	@echo "make -f Makefile.fork preflight-fork   # upstream gate + fork gate"
	@echo "make -f Makefile.fork upstream-touch   # zero-upstream-touch guard only"
	@echo "make -f Makefile.fork sync-probe       # real conflict count against upstream/main"
	@echo ""
	@echo "make -f Makefile.fork local-up         # stage 1: start the cloud-neutral local stack"
	@echo "make -f Makefile.fork local-verify     # stage 1: end-to-end proof + JSON evidence"
	@echo "make -f Makefile.fork local-status     # what is running, on which ports"
	@echo "make -f Makefile.fork local-down       # stop the stack (keeps data)"
	@echo "make -f Makefile.fork local-reset      # stop and delete local data"
	@echo "make -f Makefile.fork local-selftest   # hermetic tests for the local dev entry points and this checkout's git config"
	@echo ""
	@echo "make -f Makefile.fork local-tc-up      # Testcontainers stack (Postgres+Redis+MinIO+Better Auth+Typesense)"
	@echo "make -f Makefile.fork local-tc-status  # show what testcontainers-managed services are running"
	@echo "make -f Makefile.fork local-tc-check   # docker daemon + python-dotenv + image presence"
	@echo "make -f Makefile.fork local-tc-down    # stop containers + supervised processes"
	@echo "make -f Makefile.fork local-tc-reset   # down + delete volumes (destructive)"
	@echo "make -f Makefile.fork local-tc-logs    # tail logs (service arg required)"

setup-fork:
	@git config remote.upstream.tagOpt --no-tags && \
	 echo "upstream remote set to --no-tags (upstream release tags stay out of this fork)"

preflight-fork:
	@scripts/fork/preflight --base $(BASE)

upstream-touch:
	@python3 scripts/fork/check-upstream-touch.py --aggregate

sync-probe:
	@git fetch upstream --prune -q || true
	@printf 'real conflicts merging upstream/main into %s: ' "$$(git rev-parse --abbrev-ref HEAD)"
	@git merge-tree --write-tree HEAD upstream/main | grep -c '^CONFLICT' || true

# Fork-only developer lanes stay here so the upstream root Makefile remains
# byte-identical and never becomes an upstream-sync conflict source.
dev-shadow-diff:
	@bash dev/shadow-diff.sh

run-canonical-promotion:
	@python3 scripts/dev-harness/run-canonical-promotion.py "$(PROMOTION_USER)"

local-up:
	@bash dev/local.sh up

local-status:
	@bash dev/local.sh status

local-verify:
	@bash dev/local.sh verify

local-restart:
	@bash dev/local.sh restart

local-logs:
	@bash dev/local.sh logs $(SERVICE)

local-down:
	@bash dev/local.sh down

local-reset:
	@bash dev/local.sh reset

local-selftest:
	@python3 dev/tests/test_local_sh.py
	@python3 dev/tests/test_selfhost_local_sh.py
	@python3 dev/tests/test_git_hygiene.py

# Testcontainers-managed local stack. Brings up Postgres+Redis+MinIO+Better Auth
# containerised and runs the upstream dev-harness app services (llm-gateway, backend,
# desktop-backend) under its supervised-process machinery. State, health checks,
# status/down/reset/logs all reuse upstream dev_harness.cli via the fork-owned
# fork_local.py shim. See dev/unified-main/00-upstream-touch-policy.md §3 — this
# does NOT modify any upstream file.
local-tc-up:
	@bash scripts/dev-harness/fork_local.sh up

local-tc-status:
	@bash scripts/dev-harness/fork_local.sh status

local-tc-check:
	@bash scripts/dev-harness/fork_local.sh check

local-tc-down:
	@bash scripts/dev-harness/fork_local.sh down

local-tc-reset:
	@bash scripts/dev-harness/fork_local.sh reset

local-tc-logs:
	@bash scripts/dev-harness/fork_local.sh logs $(SERVICE)
