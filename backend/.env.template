# Stage templates (local harness / cloud dev): see backend/.env.{local-dev,offline,dev,prod}.template
# Copy one to backend/.env.<stage>, symlink backend/.env, set OMI_ENV_STAGE. See .envrc.example.

# Universal-memory deployment controls. They are global incident/readiness
# switches and never select a user, task system, or Chat-first shell.
#
# MEMORY_ENABLED is the one user-facing product switch; code fail-closes to off
# when unset. MEMORY_MODE and MEMORY_V3_GET_ENABLED are legacy one-deploy aliases
# kept so old revisions do not explode, and are written in neither overlays nor
# charts. MEMORY_CANONICAL_MAINTENANCE_ENABLED is per-deployable routing, not a
# rollout flag: false is correct here and everywhere except memory-maintenance-job,
# which is the only host of the ST->LT cron. These are local-harness defaults --
# for deployed values read backend/deploy/runtime_env/*.overlay.yaml.
MEMORY_ENABLED=off
MEMORY_MODE=off
MEMORY_CANONICAL_MAINTENANCE_ENABLED=false
MEMORY_V3_GET_ENABLED=false

# Whole-account cutover product-traffic fence. Default off until operators
# enable after the bridge release; registered in backend/deploy/runtime_env.
ACCOUNT_CUTOVER_ENFORCEMENT=off

BUCKET_SPEECH_PROFILES=
BUCKET_BACKUPS=
BUCKET_PLUGINS_LOGOS=
BUCKET_CHAT_FILES=

GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json

PINECONE_API_KEY=
PINECONE_INDEX_NAME=

REDIS_DB_HOST=
REDIS_DB_PORT=
REDIS_DB_PASSWORD=

# Model-neutral LLM routing. The deployment-wide route can be overridden per
# workload with OMI_LLM_ROUTE_<FEATURE>_{PROVIDER,MODEL,FALLBACKS}; fallback
# values are comma-separated provider:model legs.
OMI_LLM_DEFAULT_PROVIDER=
OMI_LLM_DEFAULT_MODEL=
OMI_LLM_DEFAULT_FALLBACKS=
GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_MODEL=

# Provider-neutral retrieval backends. Generic embeddings reuse the
# GENERIC_OPENAI_* endpoint and key above.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
# Authenticated desktop OCR/task/rewind embedding API. Disabled unless direct.
EMBEDDING_CAPABILITY_TRANSPORT=disabled
# Generic completion-backed client tool calls. The backend never executes tools.
PROACTIVE_TOOL_TRANSPORT=disabled
# Optional model capabilities. ``local_extraction`` stores originals privately
# in BUCKET_CHAT_FILES and executes the chat_responses model route.
# ``local_template`` renders a deterministic local PNG; ``openai_compatible``
# requires the three explicit IMAGE_GENERATION_* settings below.
APP_ICON_GENERATION_TRANSPORT=gateway
IMAGE_GENERATION_OPENAI_COMPATIBLE_BASE_URL=
IMAGE_GENERATION_OPENAI_COMPATIBLE_API_KEY=
IMAGE_GENERATION_OPENAI_COMPATIBLE_MODEL=
FILE_CHAT_TRANSPORT=openai_assistants
FILE_CHAT_LOCAL_MAX_FILE_BYTES=10485760
FILE_CHAT_LOCAL_MAX_TOTAL_BYTES=20971520
FILE_CHAT_LOCAL_MAX_CONTEXT_CHARACTERS=120000
FILE_CHAT_LOCAL_MAX_INLINE_IMAGE_BYTES=2097152
FILE_CHAT_LOCAL_MAX_TOTAL_INLINE_IMAGE_BYTES=4194304
FILE_CHAT_LOCAL_MAX_IMAGE_PIXELS=12000000
# ``sherpa_onnx`` TTS is network-free and requires a mounted VITS model,
# tokens, and espeak-ng data directory. ``openai_compatible`` has no default URL.
TTS_PROVIDER=
TTS_SHERPA_MODEL=
TTS_SHERPA_TOKENS=
TTS_SHERPA_DATA_DIR=
TTS_SHERPA_NUM_THREADS=2
TTS_SHERPA_SPEAKER_ID=0
TTS_OPENAI_COMPATIBLE_BASE_URL=
TTS_OPENAI_COMPATIBLE_API_KEY=
TTS_OPENAI_COMPATIBLE_MODEL=
TTS_OPENAI_COMPATIBLE_VOICE=
SPEAKER_EMBEDDING_PROVIDER=http
SPEAKER_EMBEDDING_MODEL=
SPEAKER_EMBEDDING_NUM_THREADS=2
FIRMWARE_RELEASE_TRANSPORT=github
FIRMWARE_RELEASE_MANIFEST_URL=
FIRMWARE_RELEASE_ASSET_ORIGIN=
FIRMWARE_RELEASE_MANIFEST_BEARER_TOKEN=
# Legacy desktop Gemini wire proxy; self-host must disable this vendor-specific surface.
DESKTOP_VENDOR_PROXY_TRANSPORT=gemini
VECTOR_STORE_PROVIDER=
QDRANT_URL=
QDRANT_PATH=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=omi

# Rebuildable vector projection rollout. Start in single/v1, enable dual_write
# with a distinct target, backfill+verify, then switch the active version.
VECTOR_PROJECTION_MODE=single
VECTOR_PROJECTION_ACTIVE_VERSION=v1
VECTOR_PROJECTION_TARGET_VERSION=
VECTOR_PROJECTION_SCHEMA_VERSION=1
# Keep every retained/rollback version here so account deletion purges all copies.
VECTOR_PROJECTION_DELETE_VERSIONS=v1

# Capabilities with provider-specific wire protocols. Unsupported/disabled
# selections return a typed unavailable result instead of pretending no data.
REALTIME_PROVIDER=
REALTIME_MODEL=
# REALTIME_PROVIDER=relay requires every value below. The URL has no vendor
# default; its exact host must occur in the allowlist and the key stays server-side.
REALTIME_RELAY_URL=
REALTIME_RELAY_API_KEY=
REALTIME_RELAY_PROVIDER_ID=
# Upstream frame dialect; omi.realtime.v1 remains only the client/backend WS subprotocol.
REALTIME_RELAY_WIRE_PROTOCOL=
REALTIME_RELAY_ALLOWED_HOSTS=
REALTIME_RELAY_MAX_MESSAGE_BYTES=1048576
REALTIME_RELAY_MAX_SESSION_SECONDS=1800
WEB_SEARCH_TRANSPORT=gateway
# Required when WEB_SEARCH_TRANSPORT=searxng. Plain HTTP is accepted only for
# explicit private/container service hosts; public services must use HTTPS.
SEARXNG_BASE_URL=
SEARXNG_RESULT_LIMIT=8
SEARXNG_TIMEOUT_SECONDS=20

# Durable provider-neutral task dispatch. Each worker deployment receives only
# the secret for its own queue; do not reuse one secret across queues.
QUEUE_BACKEND=
QUEUE_REDIS_URL=
QUEUE_REDIS_PREFIX=omi:queue
QUEUE_REDIS_DB=0
QUEUE_REDIS_SYNC_WORKER_SECRET=
QUEUE_REDIS_AUDIO_MERGE_WORKER_SECRET=
QUEUE_REDIS_ACCOUNT_DELETION_WORKER_SECRET=
QUEUE_REDIS_FINALIZATION_WORKER_SECRET=
QUEUE_REDIS_LEASE_SECONDS=1800
QUEUE_REDIS_HTTP_TIMEOUT_SECONDS=1500
QUEUE_REDIS_RETRY_BASE_SECONDS=1
QUEUE_REDIS_RETRY_MAX_SECONDS=60

# S3-compatible storage. MINIO_PUBLIC_ENDPOINT is the browser/client-facing
# origin used to sign and return URLs; MINIO_ENDPOINT may remain cluster-local.
STORAGE_BACKEND=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_SECURE=0

DEEPGRAM_API_KEY=
MODULATE_API_KEY=

ADMIN_KEY=
# Set to 'false' to disable the ADMIN_KEY<uid> local-dev auth bypass entirely
# (it defaults to 'true' for backward compatibility with existing deployments).
ADMIN_KEY_AUTH_ENABLED=true

# Provider-neutral identity. Better Auth production deployments set every
# value explicitly and share AUTH_INTERNAL_ADMIN_SECRET only server-to-server.
AUTH_PROVIDER=firebase
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_SERVER_INTERNAL_URL=
# Production accepts private HTTP JWKS/lifecycle origins only with this explicit opt-in.
AUTH_INTERNAL_ALLOW_HTTP=false
AUTH_INTERNAL_ADMIN_SECRET=
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_MAX_STALE_SECONDS=3600
PUSH_PROVIDER=firebase

# SenseVoice supports local prerecorded and bounded-window live serving. MiMo
# remains batch-only. Disable policy-default fallback for isolated deployments.
STT_SERVICE_MODELS=
STT_ROUTE_FALLBACK_TO_DEFAULT=true
STT_PRERECORDED_MODEL=
SENSEVOICE_MODEL_DIR=
SENSEVOICE_STREAM_WINDOW_SECONDS=5.0
MIMO_API_BASE=
MIMO_TOKENPLAN_BASE=
MIMO_USE_TOKENPLAN=false
MIMO_API_KEY=
MOSS_API_BASE=
MOSS_API_KEY=
# Operator-owned mlx-audio MOSS diarization. No endpoint/model defaults and no
# hosted MOSS fallback. Public HTTPS authorities require the optional key;
# private/loopback HTTP authorities may omit it.
MLX_MOSS_DIARIZE_ENDPOINT=
MLX_MOSS_DIARIZE_MODEL=
MLX_MOSS_DIARIZE_API_KEY=
# Server-side HMAC pepper for stored BYOK key fingerprints. When unset,
# fingerprints are stored as the plain client SHA-256 (legacy); when set,
# they are wrapped with this secret before storage/comparison so a leaked
# fingerprint store is not rainbow-table attackable. Leave unset for
# backward compatibility; set a stable random value to opt in.
BYOK_FINGERPRINT_PEPPER=
# Comma-separated exact origins allowed by CORS (e.g. https://app.omi.com).
# Defaults to empty (no origins) — the API is Bearer-token authenticated and
# browser default-deny already applies. Never use "*" and never combine with
# credential forwarding.
CORS_ALLOWED_ORIGINS=
OPENAI_API_KEY=

# Provider-neutral model capability routes. Leave unset for the managed profile;
# self-hosted deployments must set OMI_DEPLOYMENT_PROFILE=self_hosted plus an
# explicit operator-owned chat and embedding route. Realtime can use either an
# explicit provider token mint or an allowlisted operator websocket relay.
OMI_DEPLOYMENT_PROFILE=
OMI_LLM_DEFAULT_PROVIDER=
OMI_LLM_DEFAULT_MODEL=
OMI_LLM_DEFAULT_FALLBACKS=
EMBEDDING_CAPABILITY_TRANSPORT=disabled
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
REALTIME_PROVIDER=
REALTIME_MODEL=
REALTIME_RELAY_URL=
REALTIME_RELAY_API_KEY=
REALTIME_RELAY_PROVIDER_ID=
REALTIME_RELAY_WIRE_PROTOCOL=
REALTIME_RELAY_ALLOWED_HOSTS=
REALTIME_RELAY_MAX_MESSAGE_BYTES=1048576
REALTIME_RELAY_MAX_SESSION_SECONDS=1800

# Optional backend PostHog sink for provider sync/auth telemetry.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ElevenLabs TTS (used by /v2/tts/synthesize to speak Omi responses on mobile)
ELEVENLABS_API_KEY=

# Optional operator-configured OpenAI-compatible MiMo STT/TTS. There is no
# implicit Xiaomi/vendor endpoint; set an explicit private or operator-owned
# authority whenever STT_SERVICE_MODELS=mimo or TTS_PROVIDER=mimo is selected.
MIMO_API_KEY=
MIMO_API_BASE=
MIMO_TOKENPLAN_BASE=
MIMO_USE_TOKENPLAN=false
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=
MIMO_TTS_FORMAT=wav
MIMO_TIMEOUT_SECONDS=120

GITHUB_TOKEN=

HUME_API_KEY=
HUME_CALLBACK_URL=

# Required for conversation processing. Without this, conversations stay in_progress permanently.
HOSTED_PUSHER_API_URL=

TYPESENSE_HOST=
TYPESENSE_HOST_PORT=
TYPESENSE_API_KEY=
MEMORY_KEYWORD_INDEX_PROVIDER=typesense

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

BASE_API_URL=

RAPID_API_HOST=
RAPID_API_KEY=

# Firebase OAuth
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Project whose Firebase ID tokens this backend accepts. This is intentionally
# separate from FIREBASE_PROJECT_ID so a self-hosted data project can verify
# tokens minted for the Firebase project used by the client app. Stock Omi
# mobile builds use based-hardware-dev; custom builds use their own project ID.
FIREBASE_AUTH_PROJECT_ID=
# Google Cloud/Firebase data project used by this backend's own services.
FIREBASE_PROJECT_ID=

# Encrypts conversations, memories, and chat messages. Required; set a unique
# securely generated secret of at least 32 bytes in every real environment.
ENCRYPTION_SECRET=

# Apple and Google OAuth (also used for Google Calendar and other Google integrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
API_BASE_URL=

PERPLEXITY_API_KEY=

# Twilio (Phone Calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Integration OAuth Credentials

# Whoop OAuth Credentials
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Notion OAuth Credentials
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Twitter OAuth Credentials
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LangSmith Tracing (for LLM observability and evals)
# Get your API key from https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omi-backend-chat
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith Prompt Management
# The name of the prompt in LangSmith Hub to use for the agentic chat system
# If not set, defaults to "omi-agentic-system"
# The prompt will be fetched from LangSmith and cached for CACHE_TTL_SECONDS
OMI_LANGSMITH_AGENTIC_PROMPT_NAME=omi-agentic-system
# Cache TTL in seconds for the prompt template (default: 300 = 5 minutes)
# Lower values = faster prompt updates, higher values = fewer API calls
OMI_LANGSMITH_PROMPT_CACHE_TTL_SECONDS=300
